{
    "name": "n8n-nodes-ravendb",
    "version": "0.1.0",
    "description": "n8n community node for RavenDB — read, write, and query documents in your automation workflows, with support for both open and mTLS-secured RavenDB clusters",
    "license": "MIT",
    "homepage": "https://github.com/ravendb/n8n-nodes-ravendb",
    "keywords": [
        "n8n-community-node-package",
        "ravendb",
        "nosql",
        "document-database"
    ],
    "author": {
        "name": "Lucas Tavares",
        "email": "lucas.tavares@ravendb.net"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/ravendb/n8n-nodes-ravendb.git"
    },
   "scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/RavenDbApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/RavenDb/RavenDb.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
